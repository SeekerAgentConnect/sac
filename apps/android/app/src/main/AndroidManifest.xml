<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The network: the connections' sidecars, and the live-test screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning a pairing QR code (SAW-012), asked for only when the owner taps Scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- SAW-058 asks at runtime only in a Firebase-configured build with a usable connection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The camera is optional: a pairing code can also be entered by hand. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".SeekerVaultApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeekerVault">
        <!-- SAW-055 explicitly enables registration only while a usable connection exists. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Current FCM direct-send registration returns a Firebase Installation ID. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Data-only invalidations never ask Firebase to render UI. These defaults keep any
             operator-sent notification message on the same recognizable native identity. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_sac" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <service
            android:name=".push.SeekerVaultMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="seekervault" />
            </intent-filter>
        </activity>
    </application>

</manifest>
