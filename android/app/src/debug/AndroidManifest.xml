<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: see res/xml/network_security_config.xml in this source set. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Long-press the debug app icon and choose Component gallery. -->
        <activity
            android:name=".debug.ComponentGalleryActivity"
            android:exported="true"
            android:label="@string/component_gallery_name" />
        <activity android:name=".MainActivity">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/debug_shortcuts" />
        </activity>
    </application>
</manifest>
