<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The network: the connections' sidecars, and the live-test screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning a pairing QR code (SAW-012), asked for only when the owner taps Scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The camera is optional: a pairing code can also be entered by hand. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".SeekerVaultApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeekerVault">
        <!-- SAW-055 explicitly enables registration only while a usable connection exists. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Current FCM direct-send registration returns a Firebase Installation ID. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <service
            android:name=".push.SeekerVaultMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
