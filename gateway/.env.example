# Deployment configuration for gateway/compose.yaml.
# Copy to `.env` in this directory (ignored by git) and fill it in:
#   cp .env.example .env
# Variables already set in the environment take precedence over this file.
#
# This file is the deployment's, and separate from the repository root's
# .env.example, which configures `pnpm dev:sidecar` on a developer's machine.

# --- Required ---------------------------------------------------------------
# Two different random values, at least 32 characters, made for example with
# `openssl rand -hex 32`. MCP_TOKEN is what an agent authenticates with;
# PHONE_TOKEN is the Stage 1 live diagnostic's development token. The stack
# refuses to start while either still holds its placeholder.
MCP_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
PHONE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN

# --- The MCP adapter --------------------------------------------------------
# MCP is one way an agent reaches this sidecar, not what the sidecar is
# (SEE-87, docs/wiki/mcp-adapter.md). On by default, which is what every
# deployment before this setting existed was doing.
#
# false serves no /mcp at all and needs no MCP token: pairing, the phone's
# API, production updates, push and the wallet-signing rules are exactly the
# same, and an agent then reaches the deployment through some other adapter.
# A leftover MCP_TOKEN, MCP_ALLOWED_HOSTS or MCP_DEMO_TOOLS is ignored and
# named in the startup log; an OAuth profile is refused, because it would
# advertise authorization for an endpoint this deployment does not serve.
#
# The test-agent container is an MCP client, so it has nothing to talk to
# while this is false.
MCP_ENABLED=true

# --- The published port (local development) ---------------------------------
# Where the gateway is reachable on the host. The sidecar's own port is never
# published: it binds loopback inside the container's network namespace, and the
# gateway is the only thing that can reach it.
GATEWAY_PORT=8080
# The host address the port binds to. 127.0.0.1 keeps the gateway on the machine
# itself, which is right for a Mac and for a VPS reached over a tunnel or VPN.
# Leave it there: this configuration speaks plain HTTP. To put the stack on the
# internet, use the HTTPS overlay below rather than opening this port.
GATEWAY_BIND=127.0.0.1

# --- Going public: HTTPS on your own domain ---------------------------------
# These two are required by compose.public.yaml, the internet-facing overlay:
#
#   docker compose -f compose.yaml -f compose.public.yaml up -d --build
#
# Leave them empty for local development; the base stack ignores them.
#
# The domain this deployment answers for. It must already resolve to this host
# (an A record, an AAAA record, or both), and ports 80 and 443 must be reachable
# from the internet, before the first start: that is how Caddy obtains a publicly
# trusted certificate and renews it. The overlay also uses this name for
# MCP_ALLOWED_HOSTS and SIDECAR_PUBLIC_URL, so neither is typed twice.
GATEWAY_DOMAIN=
# Where the certificate authority sends expiry and problem notices.
ACME_EMAIL=

# --- Going public: OAuth for a hosted MCP client ----------------------------
# Optional, and needed only for a hosted client that authorizes a person instead
# of carrying a shared token — Claude's custom connectors are the one this was
# written for (docs/integrations/claude.md). An operator who connects Hermes or
# their own agent with MCP_TOKEN can leave this whole section empty.
#
# It is a third overlay, on top of the public one:
#
#   docker compose -f compose.yaml -f compose.public.yaml -f compose.oauth.yaml up -d --build
#
# The authorization server is a product you already run or sign up for; nothing
# here issues a token, registers a client, or shows a consent screen. Its issuer
# URL, exactly as its tokens spell `iss` — a trailing slash included, if it
# publishes one.
MCP_OAUTH_ISSUER=
# The audience a token must carry. Empty means https://$GATEWAY_DOMAIN/mcp, this
# deployment's canonical MCP URI, which is what a client asks for.
MCP_OAUTH_RESOURCE=
# Where the public keys are. Empty means the sidecar reads the issuer's own
# metadata document and takes jwks_uri from it.
MCP_OAUTH_JWKS_URL=
# Scopes a token must carry, separated by spaces. Empty accepts any scope the
# authorization server issued for this resource.
MCP_OAUTH_SCOPE=

# --- Reaching the sidecar from elsewhere ------------------------------------
# The host names /mcp accepts in the Host and Origin headers besides loopback,
# comma-separated, without a scheme or port. This is a DNS-rebinding defence, so
# name the hostname agents actually use, for example `vault.example.com` or a
# Tailscale name. Leave it empty when everything reaches the stack over loopback.
# The public overlay sets this from GATEWAY_DOMAIN and does not read this line.
MCP_ALLOWED_HOSTS=
# The URL a pairing code carries, where the phone reaches the sidecar. It must be
# https://, or http:// on a loopback host. Empty means http://127.0.0.1:8080,
# which reaches a phone only over `adb reverse`. A phone on another network needs
# a trusted TLS endpoint (docs/security.md). The public overlay sets this to
# https://$GATEWAY_DOMAIN and does not read this line either.
SIDECAR_PUBLIC_URL=

# --- Optional ---------------------------------------------------------------
# How long the phone has to answer a live command, 1 to 3600 seconds.
LIVE_COMMAND_TIMEOUT_SECONDS=60
# Development and demos only: true serves the demo tool vault_request_ack. Leave
# it false in a deployment.
MCP_DEMO_TOOLS=false
# How long a request waits for the owner when the agent doesn't say, 60 to 604800
# seconds. Empty means 86400 (a day).
REQUEST_TTL_SECONDS=
# The most requests that can wait for the owner at once, 1 to 10000. Empty means 100.
REQUEST_PENDING_LIMIT=
# How long a pairing code works, 60 to 3600 seconds. Empty means 600.
PAIRING_TOKEN_TTL_SECONDS=
# The Solana JSON-RPC endpoint transfers are prepared against. Without it the
# sidecar serves no vault_transfer and prepares no transaction at all, which is
# the default: the owner chooses the cluster, and nothing here chooses one for
# them. The URL may carry an API key, so keep this file out of version control.
SOLANA_RPC_URL=
# How long one chain call may take, 1000 to 20000 ms. Empty means 10000.
SOLANA_RPC_TIMEOUT_MS=
# Optional FCM sender (docs/guides/firebase.md). Empty means off. When set, this
# is the non-secret Firebase project ID; credentials come from Application
# Default Credentials in the deployment environment, never from this file.
FCM_PROJECT_ID=

# --- The test agent ---------------------------------------------------------
# Where the test-agent container finds the MCP endpoint. The default goes through
# the gateway, the way an external agent does. It works in both configurations:
# in the public one the gateway keeps this address for the stack's own use, on
# the network namespace's loopback, where nothing outside can reach it.
AGENT_MCP_URL=http://127.0.0.1:8081/mcp
