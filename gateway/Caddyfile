# The gateway's front door — local development.
#
# Plain HTTP, reachable only on the host's loopback address through the port
# compose publishes. Use this on a laptop, or on a server you reach over a VPN
# or an SSH tunnel. It is NOT the internet-facing configuration: for that, use
# `Caddyfile.public` through the `compose.public.yaml` overlay, which terminates
# TLS for a real domain. Plain HTTP must never become the public default, and
# nothing here asks anyone to ignore a certificate error.
#
# The gateway shares the sidecar's network namespace (see compose.yaml), so the
# sidecar is reachable here at 127.0.0.1:8080 and nowhere else: it binds loopback
# only, which means neither the host nor any other container can reach it. This
# listener is the single published entry point.
{
	# No admin API: nothing should be able to reconfigure the gateway at run time,
	# and its port (2019) must never appear on a public interface.
	admin off
	# The gateway's own runtime messages: startup, certificates, errors. Request
	# logging is configured per site below, because that is where Caddy puts it.
	log {
		output stderr
		format console
	}
	# `log_credentials` is deliberately absent. Without it Caddy redacts the
	# Authorization, Cookie, Set-Cookie, and Proxy-Authorization headers from
	# every request log, so no agent token, phone credential, or pairing token is
	# ever written. Turning it on would put them all in the log at once.
}

:8081 {
	# One line per request, to stderr, where `docker compose logs gateway` finds
	# it. Credentials are redacted; see the global block above.
	log {
		output stderr
		format console
	}
	# The compose healthcheck asks every 30 seconds and is not news.
	log_skip /healthz

	# Only the endpoints below exist. Everything else is refused at the door
	# rather than forwarded, so a route the sidecar may grow later is not exposed
	# by accident.

	# --- MCP: the agent's endpoint, authenticated by MCP_TOKEN ----------------
	@mcp path /mcp /mcp/*
	handle @mcp {
		# The same 64 KiB the sidecar itself enforces, applied one hop earlier.
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8080 {
			# Streamable HTTP answers over SSE, so responses must not be buffered.
			flush_interval -1
		}
	}

	# --- Connect: the phone's API, authenticated per service ------------------
	# Separate route, separate limit, and no shared credential: each service takes
	# only its own token (docs/protocol.md#roles). The gateway neither adds nor
	# removes an Authorization header, so those boundaries are the sidecar's alone.
	@connect path /seekervault.live.v1.LiveCommandService/* /seekervault.request.v1.PairingService/* /seekervault.request.v1.RequestService/* /seekervault.update.v1.UpdateService/*
	handle @connect {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8080 {
			# Server-streaming responses are long-lived; no buffering, no deadline.
			flush_interval -1
		}
	}

	# --- Health: unauthenticated, and says only {"status":"ok"} ---------------
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		abort
	}

	# The Host header is passed through unchanged, on purpose. The sidecar checks
	# it against loopback plus MCP_ALLOWED_HOSTS as a DNS-rebinding defence
	# (sidecar/src/mcp-endpoint.ts). Rewriting it here would quietly disable that
	# check; instead, a deployment names its public hostname in MCP_ALLOWED_HOSTS.
}
