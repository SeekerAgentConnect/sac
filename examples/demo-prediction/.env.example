# Application configuration reference (SEE-96, SEE-134). The canonical
# deployment template is compose/prediction/.env.example in the do-deploy repository.
# Variables already set in the environment take precedence over this file.
#
# This is the *Prediction* demo's file, and it is separate from
# examples/demo-signals/.env.example because the two demos are two deployments: two
# modules, two images, two server IDs, two credentials from the gateway, two
# databases. Running both means running two publishers
# (docs/wiki/prediction-template.md).

# --- Who this publisher is ---------------------------------------------------
# Its own UUID, registered with the gateway's operator — not the CopyTrading
# template's:
#
#   docker compose --env-file compose/feed/.env -f compose/feed/compose.yaml \
#     --profile operator run --rm gateway-ctl register --server <uuid> --label "prediction"
#
# Its channel is "server/<this>", and the gateway checks it against the
# credential below rather than against anything a document claims.
PUBLISHER_SERVER_ID=

# The shared gateway's own origin — its BROADCAST_PUBLIC_URL, character for
# character. Every manifest published to it has to name it, and the phone
# compares it with the feed reference the feed was added from.
PUBLISHER_GATEWAY_URL=

# Where publications are *sent*, when that is not the origin phones read from.
# Empty means PUBLISHER_GATEWAY_URL. Getting it wrong is the one mistake the
# gateway cannot report — a read origin has no handler that could write anything,
# so a publication gets a 404 — and the template says so at startup.
PUBLISHER_PUBLISH_URL=

# production or sandbox. One deployment serves one of them, and the database is
# stamped with it. PREDICTION_STATE=any is refused in production (below).
#
# Sandbox here too, for the same reason: copy this, run it, and the markets are
# the live ones while every phone that acts on one simulates the order and says
# so (docs/wiki/environments.md). Production is a deliberate edit of this line.
PUBLISHER_ENVIRONMENT=sandbox

# The name this server calls itself, for a connection's default label on the
# phone. Optional, at most 64 bytes on one line, and never verified.
PUBLISHER_DISPLAY_NAME=

# --- The two credentials -----------------------------------------------------
# The grant the gateway issued this publisher, printed once by its operator's own
# tool.
BROADCAST_CREDENTIAL=

# Who may call this template's API. Generate one with
#
#   openssl rand -base64 32
#
# On this template the API is read-only — its signals are written by its own
# discovery, and create, update and cancel answer 403 — so the token is what
# guards reading its status, its filters and the markets it is tracking, and
# asking it to run a cycle now. At least 32 characters, and there is no way to
# run the API without one.
PUBLISHER_API_TOKEN=

# Either may be a file instead of a value, for a deployment that mounts secrets.
# Setting both a value and a file is a configuration error.
BROADCAST_CREDENTIAL_FILE=
PUBLISHER_API_TOKEN_FILE=
# PUBLISHER_SECRETS_DIR=./secrets

# --- The provider ------------------------------------------------------------
# Jupiter's prediction API, which this template reads and nothing else does.
# Empty is the keyless host (https://lite-api.jup.ag), which serves these
# endpoints without a credential — that is what a first deployment uses and what
# the tests run against.
PREDICTION_PROVIDER_URL=

# An API key raises the rate allowance, and the keyed host requires one. It stays
# in this deployment: it is never in a manifest, a document, a log line or an
# answer this template gives, and it may be a file instead
# (PREDICTION_API_KEY_FILE).
PREDICTION_API_KEY=
PREDICTION_API_KEY_FILE=

# How long one call to the provider may take (1 to 120 seconds, default 15), and
# the least time between two of them in milliseconds (default 2100).
#
# The gap is what keeps a deployment inside the keyless allowance of one call
# every two seconds. Raising the cadence below without raising this is how a
# template starts collecting rate limits.
PREDICTION_PROVIDER_TIMEOUT_SECONDS=
PREDICTION_CALL_GAP_MS=

# --- What this publisher looks for -------------------------------------------
# Two of these are the provider's own parameters, because they decide which
# events its listing returns at all. Everything else is applied to the records
# that come back, and only to fields those records carry
# (docs/wiki/prediction-template.md#the-filters-and-what-they-mean).
#
# The venue whose markets the provider aggregates: polymarket (default), kalshi
# or bisonfi (Jupiter Forecast).
PREDICTION_SOURCE=

# The provider's buckets, comma-separated — one listing walk each. Empty means
# one walk with no bucket at all, which is its default listing. Its own set:
# all, crypto, sports, politics, esports, culture, economics, tech, finance,
# climate & science, weather, mentions.
PREDICTION_CATEGORIES=

# The provider's own named filter, or empty for none: new (created in the last
# 24 hours), live (begun), trending (recent trade activity), upcoming (not begun).
PREDICTION_FILTER=

# Applied here, to what came back.
#
# Tags are the provider's own tokens ("nfl", "fed-rates"), compared whole and
# case-insensitively against the event's tags. Empty means every event.
PREDICTION_TAGS=
# Keywords are substrings, case-insensitively, of the event's title, bucket,
# subcategory and tags together with the market's own title. Any one of them
# matching is enough. Empty means every market — which, with no categories and
# no tags either, is the provider's whole front page.
PREDICTION_KEYWORDS=

# open (default): only markets the provider would take an order for.
# any: also closed, cancelled and settled ones — **sandbox only**, and refused in
# production, because every phone then refuses the order anyway. It exists so the
# closure path can be exercised deliberately.
PREDICTION_STATE=

# The window a market's close time has to fall in, in minutes. Default 60 to
# 43200 (an hour to a month). A market with no close time at all cannot be
# judged against a window, so it is skipped whenever one is set.
PREDICTION_LEAST_CLOSE_IN_MINUTES=
PREDICTION_MOST_CLOSE_IN_MINUTES=

# How long a signal lasts for a market the provider gives no close time for, in
# hours (default 168). It is counted from when this template *first saw* the
# market, never from now: an expiry that moved with the clock would move the
# document, and wake every subscribed phone, on every cycle.
PREDICTION_LIFETIME_HOURS=

# How often a cycle runs (30 to 86400 seconds, default 300). The provider's
# prediction API has no stream to subscribe to, so this is polling, bounded.
PREDICTION_POLL_SECONDS=

# How much of the listing one cycle reads: events per call (1 to 100, default
# 25) and calls per bucket (1 to 40, default 4).
PREDICTION_PAGE_SIZE=
PREDICTION_MOST_PAGES=

# How many proposals this publisher will hold open at once (default 25), and how
# many tracked markets one cycle asks the provider about directly (default 20).
#
# Both are this template's own restraint rather than a limit of the protocol: a
# phone walks a feed in pages of fifty, and a person reads a list. When more
# markets match than the ceiling allows, the ones published are the ones closing
# soonest.
PREDICTION_MOST_OPEN=
PREDICTION_MOST_CHECKS=

# --- What every signal says about a deposit ----------------------------------
# The token a stake is deposited in: one of the two the provider takes, and
# nothing else. Empty means USDC
# (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v); the other is JupUSD
# (JuprjznTrTSp2UFa3ZBUFgwdAmtZCq4MQCwysN55USD). Its decimals and its label are
# derived from it, because a mint's decimals cannot change.
PREDICTION_DEPOSIT_MINT=

# What this publisher will have its signals acted on with, in that token's base
# units (a six-decimal token: 5000000 is five dollars). The floor is never below
# the provider's own minimum order of 5000000, whatever is set here; empty for
# the ceiling means none at all, bounded in the end by each owner's own balance.
#
# **The amount inside these bounds is not here and cannot be.** It is chosen on
# each owner's own phone, and so is the side — this template publishes which
# market, never which way (docs/security.md).
PREDICTION_LEAST_DEPOSIT=
PREDICTION_MOST_DEPOSIT=

# One line of the operator's own prose, published above the line this template
# writes itself in every signal's note. At most 400 bytes on one line, and shown
# to the owner as the publisher's words rather than as a fact.
PREDICTION_NOTE=

# --- The published port (local) ----------------------------------------------
# Where the API is reachable on the host. The canonical preset publishes the
# application's container port directly on host loopback. It uses 8094 by
# default, so it does not collide with a CopyTrading deployment's 8092.
PREDICTION_PORT=8094
PREDICTION_BIND=127.0.0.1

# --- Optional ----------------------------------------------------------------
# How long one publication to the gateway may take before it is treated as
# unreachable and retried, 1 to 120 seconds. Empty means 10.
PUBLISHER_PUBLISH_TIMEOUT_SECONDS=

# --- What is deliberately not here -------------------------------------------
# No Firebase credential, no broker, no Redis: delivery to phones is the shared
# gateway's (SEE-91, SEE-92).
#
# Nothing about a subscriber, because there is nothing to configure: this
# template never learns who reads its channel, holds no wallet, no side, no
# stake, no order and no position, and has no endpoint that would accept one.
#
# And nothing about which way a market will go. There is no model in this
# template and no field for an opinion: a signal says a market exists and that
# this publisher is following it (docs/security.md).
