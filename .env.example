# Development configuration.
# Copy to `.env` (ignored by git) and replace both token placeholders with
# different random values, for example `openssl rand -hex 32`.
# Variables already set in the environment take precedence over this file.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080
MCP_TOKEN=REPLACE_WITH_A_RANDOM_DEVELOPMENT_TOKEN
PHONE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_DEVELOPMENT_TOKEN
LIVE_COMMAND_TIMEOUT_SECONDS=60
MCP_URL=http://127.0.0.1:8080/mcp
# Optional: host names or IP addresses, comma-separated, that /mcp accepts in the Host and
# Origin headers besides loopback, for an agent that reaches the sidecar through a VPN address
# such as Tailscale (docs/integrations/hermes.md). Leave it empty otherwise.
MCP_ALLOWED_HOSTS=
# Development and demos only: true serves the demo tool vault_request_ack, which queues a
# wallet-free acknowledgement for the owner (docs/testing/stage-2.md). Empty or false means off;
# leave it off anywhere but development.
MCP_DEMO_TOOLS=true
# Optional: the SQLite file for durable requests. Empty means sidecar/data/sidecar.db; a relative
# path is resolved from the directory the sidecar starts in.
DATABASE_PATH=
# Optional: how long a request waits for the owner's decision when the agent doesn't say,
# 60 to 604800 seconds. Empty means 86400 (a day).
REQUEST_TTL_SECONDS=
# Optional: the most requests that can wait for the owner at once, 1 to 10000. Empty means 100.
REQUEST_PENDING_LIMIT=
# Optional: the URL that pairing codes carry, where the phone reaches the sidecar. It must be
# https://, or http:// on a loopback host for adb reverse. Empty means
# http://SIDECAR_HOST:SIDECAR_PORT. For a phone on another network, use a trusted TLS endpoint
# such as Tailscale Serve (docs/security.md).
SIDECAR_PUBLIC_URL=
# Production updates: set both PEM paths and make SIDECAR_PUBLIC_URL an https:// origin reached by
# the phone. The one secure listener negotiates h2 for gRPC and HTTP/1.1 for the existing routes.
# Use a publicly trusted certificate in production. Leave all three settings empty to keep the
# endpoint unavailable.
SIDECAR_TLS_CERT_PATH=
SIDECAR_TLS_KEY_PATH=
# Loopback development alternative to TLS: a separate cleartext HTTP/2 port, commonly reached
# with a second `adb reverse`. Never expose this port off the local machine, and do not combine it
# with the TLS paths.
SIDECAR_UPDATE_PORT=
# Optional: how long a pairing code works, 60 to 3600 seconds. Empty means 600 (10 minutes).
PAIRING_TOKEN_TTL_SECONDS=
# Optional: the Solana JSON-RPC endpoint transfers are prepared against, for example
# https://api.devnet.solana.com. Without it the sidecar serves no vault_transfer and prepares no
# transaction, rather than accepting requests it couldn't build. The sidecar checks that the
# endpoint's genesis hash matches the network the owner's wallet is bound to. The URL may carry an
# API key, so it is never logged; keep it out of version control.
SOLANA_RPC_URL=
# Optional: how long one chain call may take, 1000 to 20000 ms. Empty means 10000.
SOLANA_RPC_TIMEOUT_MS=
# Optional FCM sender (docs/guides/firebase.md). Empty means off: the sidecar creates no Firebase
# Admin app and all foreground streams, manual Sync, and WorkManager recovery keep working. When
# set, this is the non-secret Firebase/Google Cloud project ID. Firebase Admin obtains credentials
# from Application Default Credentials; keep service-account files outside this repository and set
# GOOGLE_APPLICATION_CREDENTIALS only in the deployment environment.
FCM_PROJECT_ID=
