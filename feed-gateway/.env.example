# Deployment configuration for feed-gateway/compose.yaml (SEE-90, SEE-91, SEE-92).
# Copy to `.env` in this directory (ignored by git) and fill it in:
#   cp .env.example .env
# Variables already set in the environment take precedence over this file.
#
# This file is the feed gateway's, and separate from gateway/.env.example,
# which configures one owner's private sidecar deployment. The two are different
# services with different operators: this one is shared, and public feeds remain anonymous.

# --- No credential belongs in this file -------------------------------------
# A publisher's credential is created by the operator's own tool and stored only
# as a hash, so there is nothing here for one to leak from:
#
#   docker compose run --rm ctl register --server <uuid> --label "copy trading"
#
# It is printed once. Give it to the publisher as its own BROADCAST_CREDENTIAL,
# rotate with `rotate`, and retire the old one with `revoke --credential <id>`.

# --- The published port (local development) ---------------------------------
# Where the gateway is reachable on the host. Its own two listeners are never
# published: they bind loopback inside the container's network namespace, and the
# proxy is the only thing that can reach them.
BROADCAST_PORT=8080
# The host address the port binds to. 127.0.0.1 keeps the gateway on the machine
# itself, which is right for a laptop and for a VPS reached over a tunnel or VPN.
# Leave it there: this configuration speaks plain HTTP. To put the gateway on the
# internet, use the HTTPS overlay below rather than opening this port.
BROADCAST_BIND=127.0.0.1

# The origin phones use, which every published manifest has to name. Empty means
# http://127.0.0.1:$BROADCAST_PORT, which reaches a phone only over
# `adb reverse`. The public overlay sets it from BROADCAST_DOMAIN and does not
# read this line.
#
# Getting it wrong is the one configuration mistake with no error message on the
# gateway: publications succeed, and every phone refuses the manifest because the
# origin is not the one it added the feed from.
BROADCAST_PUBLIC_URL=

# --- Going public: HTTPS on your own domain ---------------------------------
# These two are required by compose.public.yaml, the internet-facing overlay:
#
#   docker compose -f compose.yaml -f compose.public.yaml up -d --build
#
# Leave them empty for local development; the base stack ignores them.
#
# The domain this deployment answers for. It must already resolve to this host
# (an A record, an AAAA record, or both), and ports 80 and 443 must be reachable
# from the internet, before the first start: that is how Caddy obtains a publicly
# trusted certificate and renews it.
BROADCAST_DOMAIN=
# Where the certificate authority sends expiry and problem notices.
ACME_EMAIL=

# --- Optional ---------------------------------------------------------------
# How long past its own expiry a proposal is still served, 1 to 8760 hours. Empty
# means 168 (a week). It is how far behind a phone can be and still read a
# withdrawal rather than simply failing to find the proposal
# (docs/wiki/feed-gateway.md#retention).
BROADCAST_RETENTION_HOURS=
# The most proposals one channel may hold at once, 1 to 10000. Empty means 200.
# Nothing is evicted to make room: a publisher at its bound is refused a new
# proposal and can still update and withdraw what it has.
BROADCAST_MAX_PROPOSALS=
# Reads per second per caller, and the burst above it. Empty means 20 and 60. It
# is a backstop rather than the real limit: a reverse proxy sees a client before
# the gateway does, and is where a serious rate limit belongs.
BROADCAST_READ_RATE=
BROADCAST_READ_BURST=
# Publications per second per publisher, and the burst above it. Empty means 2
# and 20. A publisher that needs more is a conversation with the operator rather
# than a number set high enough never to come up.
BROADCAST_PUBLISH_RATE=
BROADCAST_PUBLISH_BURST=

# --- The broker's two secrets (SEE-91) --------------------------------------
# The gateway and the broker share these. The first lets the gateway publish to
# the broker's API; the second is what a listener's ticket is signed with, and
# what the broker verifies it against. Both are the deployment's, not a
# publisher's: they say nothing about who may publish (that is a credential in
# the gateway's database) and everything about who may fan out and who may
# listen.
#
# Generate them, once, with anything that produces 32 random bytes:
#
#   openssl rand -base64 32
#
# Rotating them is a restart of the two services, and it ends every listener's
# stream: each one reconnects, asks the gateway for a new ticket and carries on,
# which is the same path a node restart takes.
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_KEY=

# --- The stream's own settings (all optional) --------------------------------
# Where the gateway reaches the broker's API. The default is the compose
# service on the internal network. **Unset it to run without a stream**: the
# gateway then holds the documents and answers every read, and a phone that asks
# to listen is told there is none — a smaller deployment rather than a broken
# one.
#
# It is plain HTTP on the deployment's internal network on purpose: nothing
# routes to that port from outside, and the key on it can publish anything to any
# channel. The image does carry a CA bundle since SEE-92 — the push relay talks
# TLS to Google — so a broker behind TLS also works now; it is still not what
# this stack does, because a TLS hop between two containers on an internal
# network protects nothing that network does not already.
BROADCAST_STREAM_URL=

# How long a listener's ticket lasts, in minutes (default 60), and how many
# channels one ticket may grant (default 32). The phone reconnects when a ticket
# expires, so the first number is a bound on a grant rather than a timeout
# anybody waits for.
BROADCAST_TICKET_MINUTES=
BROADCAST_MAX_CHANNELS=

# What the recovery cache may grow to before the oldest history is evicted. It is
# a cache: a listener whose history was evicted reads a snapshot from the gateway
# instead, which is what it does on a first connection anyway.
REDIS_MAX_MEMORY=256mb

# --- The push relay (SEE-92) ------------------------------------------------
# Off unless you run the overlay that turns it on:
#
#   docker compose -f compose.yaml -f compose.push.yaml up -d --build
#
# What it does: after a publication commits, one content-free message goes to the
# feed's public Firebase topic, so a phone that is not being looked at wakes up
# and reads the feed from this gateway. The message names no proposal, no
# revision and no publisher; which feed changed is the topic it arrived on, and
# nothing in it is acted on (docs/guides/firebase.md).
#
# The path of a Firebase service account file **on this host**, for the project
# whose app the phones are running. The overlay mounts it read-only into the
# gateway and into nothing else.
#
# Do not put the credential itself in this file, and do not copy it into the
# checkout. A path is configuration; what it points at is the one credential in
# this deployment that has to be usable rather than compared.
BROADCAST_PUSH_CREDENTIALS_FILE=
# Which topics this deployment sends on: production or sandbox. Required by the
# overlay. It scopes every topic name, so one Firebase project can serve a
# sandbox deployment and a production one without a sandbox publication waking a
# production subscriber. It is not what a server promises when the owner
# approves; that is SEE-97.
BROADCAST_PUSH_ENVIRONMENT=
# The push API. Empty means Firebase's own (https://fcm.googleapis.com). It is a
# setting rather than a constant because the gateway compiles in no address at
# all, and because a deployment testing this wants to point it somewhere of its
# own.
BROADCAST_PUSH_ENDPOINT=
# Hints per topic per second, and the burst above it. Empty means 0.1 and 5: one
# every ten seconds, with five in hand for a publisher that republishes a handful
# at once. Above it, hints are dropped rather than queued — a hint is news that
# something changed, the next one carries the same news, and every document is
# stored and readable either way.
BROADCAST_PUSH_RATE=
BROADCAST_PUSH_BURST=
