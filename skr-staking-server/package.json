{
  "name": "@seeker-vault/skr-staking-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone SKR staking MCP server for Seeker Agent Connect",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrRenat/SeekerAgentWallet.git",
    "directory": "skr-staking-server"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "bin": {
    "seeker-skr-staking-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm --filter @seeker-vault/server-sdk run build && tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../.env src/cli.ts start",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@seeker-vault/server-sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
