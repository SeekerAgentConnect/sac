# Application configuration reference for the SKR staking server.
# For Docker, copy deploy/skr-staking/.env.example instead.
#
# Every name is prefixed SKR_STAKING_ on purpose: this server is meant to run beside the general
# MCP server, often on one host and out of one .env, and two servers that both read SIDECAR_PORT
# cannot both be configured.
#
# Generate the agent's token with: openssl rand -hex 32
SKR_STAKING_MCP_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
SKR_STAKING_HOST=127.0.0.1
SKR_STAKING_PORT=8090

# Required. Mainnet-beta only: the staking program is deployed there and nowhere else, and this
# server compares genesis hashes at startup rather than trusting the URL's name.
SKR_STAKING_RPC_URL=
SKR_STAKING_RPC_TIMEOUT_MS=10000

# Required when SKR_STAKING_HOST is a wildcard: a pairing code has to name an origin a phone can
# reach, and 0.0.0.0 is a bind address rather than one.
SKR_STAKING_PUBLIC_URL=http://127.0.0.1:8090

SKR_STAKING_DATA_DIR=
SKR_STAKING_DATABASE_PATH=
SKR_STAKING_REQUEST_TTL_SECONDS=86400
SKR_STAKING_PENDING_LIMIT=100
SKR_STAKING_PAIRING_TOKEN_TTL_SECONDS=600
# Optional: host names or addresses, comma-separated, that /mcp accepts besides loopback, for an
# agent reaching this server through a VPN address. No scheme, no port, no wildcard — a value
# that is not a host name stops startup rather than being quietly dropped.
SKR_STAKING_ALLOWED_HOSTS=

# Optional: which guardian's pool to stake into. Empty means the official one. The phone verifies
# the pool it was compiled with, so a server that names another one has its transactions refused.
SKR_STAKING_GUARDIAN=

# Optional: serve h2c instead of HTTP/1.1, for a TLS-terminating HTTP/2 proxy in front.
SKR_STAKING_H2C=false
