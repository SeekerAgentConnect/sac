# The feed broker image: official Centrifugo with this module's pinned config.
# App Platform cannot bind-mount centrifugo.yaml, so the file is copied in.
# Secrets stay in the environment (CENTRIFUGO_HTTP_API_KEY,
# CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY, CENTRIFUGO_ENGINE_REDIS_ADDRESS).
#
# Build from services/gateway/:
#   docker buildx build --platform linux/amd64 -f Dockerfile.centrifugo \
#     -t brenat/seeker-agent-connect:centrifugo-0.1.1 .
# Release identity (SEE-168). The defaults make a local `docker build` produce an image that is
# honestly labelled as one, and .github/workflows/release.yml passes the released version and the
# exact commit it was built from, so an image digest can always be traced back to a revision.
ARG VERSION=0.0.0-dev
ARG REVISION=unknown

FROM centrifugo/centrifugo:v6.9.6
COPY --chown=1000:1000 centrifugo.yaml /centrifugo/config.yaml
CMD ["centrifugo", "-c", "/centrifugo/config.yaml"]

ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.title="Seeker Agent Connect feed broker" \
      org.opencontainers.image.description="Centrifugo, pinned to the feed gateway's configuration." \
      org.opencontainers.image.source="https://github.com/SeekerAgentConnect/sac" \
      org.opencontainers.image.url="https://github.com/SeekerAgentConnect/sac" \
      org.opencontainers.image.documentation="https://github.com/SeekerAgentConnect/sac/blob/master/services/gateway/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Seeker Agent Connect" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
