{
  "name": "gateway-centrifugo",
  "root": "services/gateway/centrifugo",
  "sourceRoot": "services/gateway",
  "projectType": "application",
  "tags": ["toolchain:docker", "release"],
  "targets": {
    "check": {
      "command": "node scripts/check-centrifugo.mjs",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/services/gateway/centrifugo.yaml",
        "{workspaceRoot}/services/gateway/Dockerfile.centrifugo",
        "{workspaceRoot}/scripts/check-centrifugo.mjs"
      ]
    }
  }
}
