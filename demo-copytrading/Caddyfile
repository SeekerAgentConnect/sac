# A publisher template's front door — local development.
#
# Plain HTTP, reachable only on the host's loopback address through the port
# compose publishes. Use this on a laptop, on a server reached over a VPN or an
# SSH tunnel, or wherever the process that writes the signals runs beside the
# template. It is NOT the internet-facing configuration: for that, use
# `Caddyfile.public` through the `compose.public.yaml` overlay.
#
# The proxy shares the template's network namespace (see compose.yaml), so the
# API is reachable here at 127.0.0.1:8092 and nowhere else. This listener is the
# single published entry point.
#
# Nothing here authenticates anything. The token is checked by the template, in
# one place, in constant time (publisher-support/api), and this proxy neither
# adds nor removes an Authorization header: a proxy that could add one would be a
# second place that decides who may publish.
{
	# No admin API: nothing should be able to reconfigure the proxy at run time,
	# and its port (2019) must never appear on a public interface.
	admin off
	log {
		output stderr
		format console
	}
	# `log_credentials` is deliberately absent. Without it Caddy redacts the
	# Authorization, Cookie, Set-Cookie and Proxy-Authorization headers from every
	# request log, so neither the API token nor the gateway credential is ever
	# written down here.
}

:8093 {
	log {
		output stderr
		format console
	}
	# The compose healthcheck asks every 30 seconds and is not news.
	log_skip /healthz

	# The API, and the health probe. Everything else is refused at the door rather
	# than forwarded: this template serves nine endpoints and has no static files,
	# no metrics port and no administrative surface.
	@api path /v1/*
	handle @api {
		# The same 64 KiB the template itself enforces, applied one hop earlier. A
		# signal is a note and at most thirty-two bounded terms.
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8092
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8092
	}

	handle {
		abort
	}
}
