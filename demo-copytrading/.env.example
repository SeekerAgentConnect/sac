# Application configuration reference (SEE-95). The canonical deployment
# template is deploy/copytrading/.env.example.
# Variables already set in the environment take precedence over this file.
#
# This file is a *publisher's*, separate from the feed and direct MCP server:
# the shared gateway is whoever hosts the broadcast, the direct server is one
# owner's own, and this is a developer's or a trader's
# (docs/wiki/copytrading-template.md).

# --- Who this publisher is ---------------------------------------------------
# The lowercase UUID the gateway's operator registered this publisher with:
#
#   docker compose --env-file deploy/feed/.env -f deploy/feed/compose.yaml \
#     --profile operator run --rm gateway-ctl register --server <uuid> --label "copy trading"
#
# It is the identity in this template's manifest and in every signal it
# publishes, its channel is "server/<this>", and the gateway checks it against
# the credential below rather than against anything a document claims.
PUBLISHER_SERVER_ID=

# The shared gateway's own origin — its BROADCAST_PUBLIC_URL, character for
# character. Every manifest published to it has to name it, and the phone
# compares it with the feed reference the feed was added from, so a mismatch is
# a feed nobody can read.
PUBLISHER_GATEWAY_URL=

# Where publications are *sent*, when that is not the origin phones read from.
# Empty means PUBLISHER_GATEWAY_URL, which is right when the gateway's own proxy
# serves both APIs on one origin — the optional feed ingress does.
# Set it when the gateway is run with separate loopback listeners (reads on 8090,
# publications on 8091), or when an operator keeps publishing off the internet
# and publishers reach it over a tunnel or a private interface.
#
# Getting it wrong is the one mistake the gateway cannot report: a read origin
# has no handler that could write anything, so a publication gets a 404. The
# template says so at startup and names this variable.
PUBLISHER_PUBLISH_URL=

# production or sandbox: what a phone is told this server promises when its owner
# approves a signal (SEE-97). One deployment serves one of them, and the database
# is stamped with it — pointing a sandbox deployment at a production volume is
# refused at startup rather than silently mixed.
#
# This example is a sandbox, so that copying it and running it demonstrates the
# whole path without anybody's money: a phone reads these signals, reviews them
# and simulates the execution, and says so on the screen and in its own record.
# Production is a deliberate edit of this line (docs/wiki/environments.md). The
# code has no default — a deployment that says nothing does not start.
PUBLISHER_ENVIRONMENT=sandbox

# The name this server calls itself, for a connection's default label on the
# phone. Optional, at most 64 bytes on one line, and never verified: the owner
# can rename any connection, and their name is the one the app shows.
PUBLISHER_DISPLAY_NAME=

# --- The two credentials, which are different things -------------------------
# BROADCAST_CREDENTIAL is the grant the *gateway* issued this publisher. It is
# printed once, by the gateway operator's own tool, and it says which server this
# template publishes as.
BROADCAST_CREDENTIAL=

# PUBLISHER_API_TOKEN is who may call *this* template's API. Generate one with
#
#   openssl rand -base64 32
#
# Holding it is the whole of the grant to publish through this template: whoever
# has it can say anything this publisher can say, to everybody subscribed. At
# least 32 characters, and there is no way to run the API without one.
PUBLISHER_API_TOKEN=

# Either secret may be a file instead of a value — which is what a deployment
# that mounts secrets rather than setting environment variables wants. Name the
# path here, uncomment the mount in compose.yaml, and leave the value above
# empty; setting both a value and a file is a configuration error, because then
# there would be two answers and no way to tell which was used.
BROADCAST_CREDENTIAL_FILE=
PUBLISHER_API_TOKEN_FILE=
# PUBLISHER_SECRETS_DIR=./secrets

# Optional. The most new signals this process will accept in one hour. Empty or
# 0 is unlimited (the default, so existing tests stay valid). The CopyTrading
# demo compose service sets 200.
# PUBLISHER_CREATE_LIMIT=

# --- The published port (local) ----------------------------------------------
# Where Compose publishes the container's API directly on the host.
PUBLISHER_PORT=8092
# The host address the port binds to. 127.0.0.1 keeps the API on the machine
# itself, which is right for a laptop, for a strategy process running beside the
# template, and for a VPS reached over a tunnel or a VPN. Leave it there: this
# configuration speaks plain HTTP, and what is on this port is a write API.
PUBLISHER_BIND=127.0.0.1

# --- Optional ----------------------------------------------------------------
# How long one publication to the gateway may take before it is treated as
# unreachable and retried, 1 to 120 seconds. Empty means 10. A publication that
# times out is retried with the identical document, which the gateway answers
# "unchanged" if it did arrive — so a slow gateway costs a delay and never a
# duplicate signal.
PUBLISHER_PUBLISH_TIMEOUT_SECONDS=

# --- What is deliberately not here -------------------------------------------
# No Firebase credential, no broker address, no Redis: delivery to phones is the
# shared gateway's (SEE-91, SEE-92), and this template submits one document per
# thing it has to say and is done.
#
# And nothing about a subscriber, because there is nothing to configure: this
# template never learns who reads its channel, holds no wallet, no amount, no
# decision and no execution result, and has no endpoint that would accept one
# (docs/security.md).
