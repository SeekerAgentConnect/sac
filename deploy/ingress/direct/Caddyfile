{
	admin off
	email {$ACME_EMAIL}
	log {
		output stderr
		format console
	}
}

{$DIRECT_DOMAIN} {
	log {
		output stderr
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@oauth path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @oauth {
		reverse_proxy mcp-server:8080
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		request_body {
			max_size 64KiB
		}
		reverse_proxy mcp-server:8080 {
			flush_interval -1
		}
	}

	# The native cleartext listener carries pairing and unary request calls. The production
	# UpdateService stream is not advertised through this HTTP/1 upstream; use the server's native
	# TLS listener plus a raw TCP forward when production updates are required.
	@phone path /seekervault.request.v1.PairingService/* /seekervault.request.v1.RequestService/*
	handle @phone {
		request_body {
			max_size 64KiB
		}
		reverse_proxy mcp-server:8080 {
			flush_interval -1
		}
	}

	# No health, legacy live diagnostic, or undeclared future route is public.
	handle {
		abort
	}
}

:443 {
	abort
}
