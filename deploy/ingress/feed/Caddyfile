{
	admin off
	email {$ACME_EMAIL}
	log {
		output stderr
		format console
	}
}

{$FEED_DOMAIN} {
	log {
		output stderr
		format console
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@feed path /seekervault.gateway.v1.FeedService/*
	handle @feed {
		request_body {
			max_size 64KiB
		}
		reverse_proxy feed-gateway:8090
	}

	# Authenticated by the feed gateway's publisher credential. The operator can delete this
	# block and use the host-loopback/private publisher listener without changing phone access.
	@publish path /seekervault.gateway.v1.PublisherService/*
	handle @publish {
		request_body {
			max_size 64KiB
		}
		reverse_proxy feed-gateway:8091
	}

	# The operator's admin page (SEE-141), on the gateway's own third listener. It answers only
	# after a session cookie from its own login form; an anonymous request is sent to that form,
	# and a publisher credential is not an administrator credential anywhere.
	#
	# The operator can delete this block: the page is then reachable only over a tunnel, a VPN or
	# an SSH forward to 127.0.0.1:8092, and nothing else changes. Keep the path in step with
	# BROADCAST_ADMIN_PATH, which defaults to /admin.
	@admin path /admin /admin/*
	handle @admin {
		request_body {
			max_size 64KiB
		}
		reverse_proxy feed-gateway:8092
	}

	@stream path /centrifugal.centrifugo.unistream.CentrifugoUniStream/Consume
	handle @stream {
		reverse_proxy h2c://centrifugo:11000 {
			flush_interval -1
			transport http {
				versions h2c
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# No health, operator CLI, broker API/admin, Redis, SQLite, or demo control route is public.
	# The gateway's own admin page above is the one authenticated exception, and it is a route the
	# operator opted into rather than one that appeared.
	handle {
		abort
	}
}

:443 {
	abort
}
