# Copy to .env.direct. The optional direct sidecar is independent of the
# broadcast gateway and demo publishers.

# Used by tls-from-tailscale.sh and the Funnel commands in README.md.
SERVER_DOMAIN=hermes.tail5e20a8.ts.net
PUBLIC_PORT=10000

# The sidecar receives the fully resolved public origin; env_file values are not
# shell-expanded, so keep these three lines in step if a port or name changes.
SIDECAR_PORT=8443
SIDECAR_PUBLIC_URL=https://hermes.tail5e20a8.ts.net:10000
MCP_ALLOWED_HOSTS=hermes.tail5e20a8.ts.net

# Two distinct random values, at least 32 characters. Set MCP_ENABLED=false to
# keep pairing/private phone APIs and return 404 from MCP and OAuth metadata.
MCP_ENABLED=true
MCP_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
PHONE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN
MCP_DEMO_TOOLS=false
LIVE_COMMAND_TIMEOUT_SECONDS=60

# Empty removes the transfer tool; devnet is the original safe direct default.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_TIMEOUT_MS=

# Optional direct-request Firebase sender. Its service account belongs in
# secrets/sidecar, separate from the broadcast relay's credential.
FCM_PROJECT_ID=

REQUEST_TTL_SECONDS=
REQUEST_PENDING_LIMIT=
PAIRING_TOKEN_TTL_SECONDS=
