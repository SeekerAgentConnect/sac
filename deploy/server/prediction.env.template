# Copy to .env.prediction. This publisher has its own identity, gateway grant,
# API token and volume; do not reuse the CopyTrading values.

PUBLISHER_SERVER_ID=
PUBLISHER_GATEWAY_URL=https://feeds.example.com
PUBLISHER_ENVIRONMENT=sandbox
PUBLISHER_DISPLAY_NAME=Jupiter Prediction demo

BROADCAST_CREDENTIAL=
BROADCAST_CREDENTIAL_FILE=/run/secrets/broadcast-credential
PUBLISHER_API_TOKEN=
PUBLISHER_API_TOKEN_FILE=/run/secrets/api-token
PUBLISHER_PUBLISH_TIMEOUT_SECONDS=

# Empty uses Jupiter's keyless endpoint. Put a provider key in the prediction
# secret directory and set /run/secrets/prediction-api-key only when needed.
PREDICTION_PROVIDER_URL=
PREDICTION_API_KEY=
PREDICTION_API_KEY_FILE=
PREDICTION_PROVIDER_TIMEOUT_SECONDS=
PREDICTION_CALL_GAP_MS=

# A bounded first demo: live open crypto markets, at most three proposals.
PREDICTION_SOURCE=polymarket
PREDICTION_CATEGORIES=crypto
PREDICTION_FILTER=
PREDICTION_TAGS=
PREDICTION_KEYWORDS=
PREDICTION_STATE=open
PREDICTION_LEAST_CLOSE_IN_MINUTES=60
PREDICTION_MOST_CLOSE_IN_MINUTES=43200
PREDICTION_LIFETIME_HOURS=168
PREDICTION_POLL_SECONDS=300
PREDICTION_PAGE_SIZE=25
PREDICTION_MOST_PAGES=4
PREDICTION_MOST_OPEN=3
PREDICTION_MOST_CHECKS=20

PREDICTION_DEPOSIT_MINT=
PREDICTION_LEAST_DEPOSIT=5000000
PREDICTION_MOST_DEPOSIT=
PREDICTION_NOTE=Demo discovery; execution is simulated on the phone.
