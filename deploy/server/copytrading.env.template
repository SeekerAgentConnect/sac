# Copy to .env.copytrading. This file contains configuration only; the two
# credentials are separate files under secrets/copytrading.

# A unique lowercase UUID registered by gateway-ctl for this publisher.
PUBLISHER_SERVER_ID=

# The externally reachable gateway origin, character for character. This is
# written into the manifest and feed reference. Never put `broadcast:8082` here.
PUBLISHER_GATEWAY_URL=https://feeds.example.com

# The shipped demo is a rehearsal. Sandbox is simulated by the phone; it is not
# Jupiter devnet and neither template submits or spends anything.
PUBLISHER_ENVIRONMENT=sandbox
PUBLISHER_DISPLAY_NAME=CopyTrading demo

# Existing publisher configuration contract, using files rather than values.
BROADCAST_CREDENTIAL=
BROADCAST_CREDENTIAL_FILE=/run/secrets/broadcast-credential
PUBLISHER_API_TOKEN=
PUBLISHER_API_TOKEN_FILE=/run/secrets/api-token
PUBLISHER_PUBLISH_TIMEOUT_SECONDS=

# Optional. 0 / empty is unlimited. compose.demos.yaml sets 200 on the service
# unless COPYTRADING_CREATE_LIMIT overrides it.
PUBLISHER_CREATE_LIMIT=
