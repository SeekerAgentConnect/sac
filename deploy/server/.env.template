# Deployment configuration for deploy/server/compose.yaml.
# Copy to `.env` in this directory (ignored by git) and fill it in:
#   cp .env.template .env
# Variables already set in the environment take precedence over this file.

# --- Required ---------------------------------------------------------------
# The name on the certificate, which is the name in every pairing code and the
# only Host /mcp accepts. Behind Tailscale Funnel it is the node's MagicDNS name.
SERVER_DOMAIN=hermes.tail5e20a8.ts.net

# Two different random values, at least 32 characters, made for example with
# `openssl rand -hex 32`. MCP_TOKEN is what an agent authenticates with;
# PHONE_TOKEN is the Stage 1 live diagnostic's token. The sidecar refuses to
# start while either still holds its placeholder.
MCP_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
PHONE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN

# --- Ports ------------------------------------------------------------------
# The port the world connects to. It is part of the public origin,
# https://SERVER_DOMAIN:PUBLIC_PORT, so it is in every pairing code. Funnel allows
# 443, 8443, or 10000, and 443 is usually taken by the node's HTTPS serve.
PUBLIC_PORT=10000
# The sidecar's own port on the server's loopback, where the TCP forward lands.
# Above 1024 (the image runs unprivileged) and free on the server.
SIDECAR_PORT=8443

# --- Image ------------------------------------------------------------------
# The sidecar image to run. Leave the default to pull the published amd64 tag,
# or name one you built from a checkout: docker build -f sidecar/Dockerfile .
#SIDECAR_IMAGE=docker.io/brenat/seeker-agent-connect:sidecar-v1

# --- Transfers --------------------------------------------------------------
# Solana JSON-RPC endpoint. Empty serves no transfer tool at all. The URL may
# carry a provider key; the sidecar never logs it.
SOLANA_RPC_URL=https://api.devnet.solana.com
#SOLANA_RPC_TIMEOUT_MS=

# --- Push invalidation (Firebase Cloud Messaging) ---------------------------
# Optional, docs/guides/firebase.md. The Firebase project the app is registered
# with — the `project_id` in the app's google-services.json. Empty keeps the
# sender off; the phone then relies on its own refresh and the update stream.
# With it set, compose.yaml mounts ./secrets/fcm-service-account.json into the
# container and points Application Default Credentials at it; the README says
# how to create that file and what role it needs. Nothing about the credential
# goes in this file.
FCM_PROJECT_ID=

# --- Optional ---------------------------------------------------------------
# How long the Stage 1 diagnostic waits for the phone.
LIVE_COMMAND_TIMEOUT_SECONDS=60
# vault_request_ack, the wallet-free demo tool. A deployment leaves it off.
MCP_DEMO_TOOLS=false
# Request lifetime, the most PENDING requests at once, and pairing-code lifetime,
# in seconds; empty keeps the sidecar's defaults.
#REQUEST_TTL_SECONDS=
#REQUEST_PENDING_LIMIT=
#PAIRING_TOKEN_TTL_SECONDS=
