# Part 1 app-infrastructure configuration. Copy to .env in this directory.
# Optional demo and direct-sidecar settings live in their own templates, so this
# file is sufficient to resolve and start the base stack by itself.

# Public DNS name for the gateway. Its A/AAAA records must point at the server;
# Caddy obtains and renews a public certificate on ports 80 and 443.
BROADCAST_DOMAIN=feeds.example.com
ACME_EMAIL=operator@example.com

# Host bindings of Caddy's two ports; empty keeps the public 80 and 443. Behind
# Tailscale Funnel (compose.tailscale.yaml) both move to loopback, BROADCAST_DOMAIN
# is the node's MagicDNS name, and ACME_EMAIL is unused: README section 7.
#GATEWAY_HTTP_BIND=127.0.0.1:9080
#GATEWAY_HTTPS_BIND=127.0.0.1:9443
# Funnel's public port when the node's 443 is taken: 8443 or 10000 (the sidecar's
# default). The origin, and every PUBLISHER_GATEWAY_URL, then carries the port.
#GATEWAY_PUBLIC_PORT=8443

# Two independent 32-byte random values. Generate each with:
#   openssl rand -hex 32
# They are shared only by the gateway and Centrifugo and must differ.
CENTRIFUGO_API_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
CENTRIFUGO_TOKEN_KEY=REPLACE_WITH_DIFFERENT_64_RANDOM_HEX_CHARACTERS

# Images. The defaults are built from the current checkout by Compose. Set these
# to tags loaded or pulled on the server when images were built elsewhere.
#BROADCAST_IMAGE=registry.example.com/seeker-broadcast:COMMIT
#PUBLISHER_IMAGE=registry.example.com/seeker-publisher:COMMIT
#SIDECAR_IMAGE=docker.io/brenat/seeker-agent-connect:sidecar-v1

# Firebase feed invalidation relay. Empty is a supported no-Firebase deployment:
# foreground streaming and authoritative reads continue, but closed apps receive
# no immediate feed hint. To enable it, put the service-account JSON at
# secrets/broadcast/fcm-service-account.json and set these two lines.
BROADCAST_PUSH_CREDENTIALS=
BROADCAST_PUSH_ENVIRONMENT=
BROADCAST_PUSH_ENDPOINT=
BROADCAST_PUSH_RATE=
BROADCAST_PUSH_BURST=

# Optional gateway and broker bounds; empty selects implementation defaults.
BROADCAST_RETENTION_HOURS=
BROADCAST_MAX_PROPOSALS=
BROADCAST_READ_RATE=
BROADCAST_READ_BURST=
BROADCAST_PUBLISH_RATE=
BROADCAST_PUBLISH_BURST=
BROADCAST_TICKET_MINUTES=
BROADCAST_MAX_CHANNELS=
REDIS_MAX_MEMORY=256mb

# Optional host-loopback demo control ports. These are not gateway ports.
COPYTRADING_PORT=8092
PREDICTION_PORT=8094
