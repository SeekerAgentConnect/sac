MCP_TOKEN=REPLACE_WITH_A_RANDOM_AGENT_TOKEN
PHONE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_PHONE_TOKEN
LIVE_COMMAND_TIMEOUT_SECONDS=30
MCP_ENABLED=true
MCP_DEMO_TOOLS=false
MCP_ALLOWED_HOSTS=
SIDECAR_PUBLIC_URL=http://127.0.0.1:8080
# Native TLS overlay only: absolute host directory containing fullchain.pem and privkey.pem.
MCP_TLS_DIR=
# Optional private/test CA inside the read-only TLS mount, for example /run/tls/ca.pem.
SIDECAR_HEALTH_CA_CERT_PATH=
MCP_SERVER_BIND=127.0.0.1
MCP_SERVER_PORT=8080
MCP_VOLUME_NAME=seeker-agent-connect-mcp_mcp-data
DATABASE_PATH=/data/sidecar.db
REQUEST_TTL_SECONDS=
REQUEST_PENDING_LIMIT=
PAIRING_TOKEN_TTL_SECONDS=
SOLANA_RPC_URL=
SOLANA_RPC_TIMEOUT_MS=
FCM_PROJECT_ID=
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_SCOPE=
DIRECT_INGRESS_NETWORK=seeker-direct-ingress
