# Portable feed base. Copy to .env and replace both secret placeholders.
BROADCAST_PUBLIC_URL=http://127.0.0.1:8080
BROADCAST_BIND=127.0.0.1
BROADCAST_PORT=8080
BROADCAST_PUBLISH_BIND=127.0.0.1
BROADCAST_PUBLISH_PORT=8091
BROADCAST_DATABASE_PATH=/data/broadcast.db
BROADCAST_VOLUME_NAME=seeker-broadcast_broadcast-data
BROADCAST_RETENTION_HOURS=
BROADCAST_MAX_PROPOSALS=
BROADCAST_READ_RATE=
BROADCAST_READ_BURST=
BROADCAST_PUBLISH_RATE=
BROADCAST_PUBLISH_BURST=
BROADCAST_TICKET_MINUTES=
BROADCAST_MAX_CHANNELS=

CENTRIFUGO_API_KEY=REPLACE_WITH_A_RANDOM_SECRET
CENTRIFUGO_TOKEN_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# Leave empty while using the proxyless read endpoint. Set to http://centrifugo:8000 only when
# a same-origin feed ingress is running; otherwise a phone would receive a ticket for a stream the
# advertised origin does not route.
BROADCAST_STREAM_URL=
# When ingress is enabled, copy the two Centrifugo values below into these two gateway settings.
# All three BROADCAST_STREAM_* settings stay empty for the proxyless snapshot-only preset.
BROADCAST_STREAM_API_KEY=
BROADCAST_STREAM_TOKEN_KEY=
# redis://user:password@host:6379/0 or rediss://user:password@host:6379/0 are supported.
CENTRIFUGO_REDIS_URL=redis://redis:6379
CENTRIFUGO_REDIS_PREFIX=seekervault
CENTRIFUGO_REDIS_TLS_SERVER_CA_PEM=
CENTRIFUGO_REDIS_TLS_SERVER_NAME=
CENTRIFUGO_REDIS_TLS_CERT_PEM=
CENTRIFUGO_REDIS_TLS_KEY_PEM=
REDIS_MAX_MEMORY=256mb

# Optional Firebase relay; deploy/feed/compose.push.yaml supplies the credential mount.
BROADCAST_PUSH_CREDENTIALS=
BROADCAST_PUSH_ENDPOINT=
BROADCAST_PUSH_ENVIRONMENT=
BROADCAST_PUSH_RATE=
BROADCAST_PUSH_BURST=
BROADCAST_PUSH_CREDENTIALS_FILE=

# Named private networks used by the separately managed ingress project.
FEED_INGRESS_NETWORK=seeker-feed-ingress
FEED_INGRESS_SUBNET=172.30.135.0/24
BROADCAST_TRUSTED_PROXIES=172.30.135.0/24
FEED_PRIVATE_NETWORK=seeker-feed-private
