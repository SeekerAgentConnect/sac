{
	admin off
	log {
		output stderr
		format console
	}
}

{$FEED_DOMAIN} {
	tls /run/tls/fullchain.pem /run/tls/privkey.pem
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@feed path /seekervault.gateway.v1.FeedService/*
	handle @feed {
		reverse_proxy feed-gateway:8090
	}

	@stream path /centrifugal.centrifugo.unistream.CentrifugoUniStream/Consume
	handle @stream {
		reverse_proxy h2c://centrifugo:11000 {
			flush_interval -1
			transport http {
				versions h2c
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		abort
	}
}
