{
  "name": "seeker-vault",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "build:server-sdk": "pnpm --filter @seeker-vault/server-sdk run build",
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run build:server-sdk && pnpm --recursive run typecheck && pnpm --recursive run test",
    "check:gateway": "node scripts/check-feed-gateway.mjs",
    "check:feed-gateway": "pnpm run check:gateway",
    "check:broadcast": "pnpm run check:gateway",
    "check:loadtest": "node scripts/check-loadtest.mjs",
    "check:demos": "node scripts/check-demos.mjs",
    "check:publisher-support": "node scripts/check-demos.mjs publisher-support",
    "check:demo-signals": "node scripts/check-demos.mjs demo-signals",
    "check:demo-prediction": "node scripts/check-demos.mjs demo-prediction",
    "check:copytrading": "pnpm run check:demo-signals",
    "check:prediction": "pnpm run check:demo-prediction",
    "check:deployments": "node scripts/check-deployments.mjs",
    "design:capture": "npm --prefix design/tools run capture --",
    "check:android": "apps/android/gradlew -p apps/android spotlessCheck checkDesignSystemLiterals :designsystem:verifyRoborazziDebug :app:verifyRoborazziDebug :designsystem:lintDebug :app:testDebugUnitTest :app:lintDebug :app:assembleDebug :app:assembleDebugAndroidTest",
    "check:format": "prettier --check . && buf format packages/protocol --diff --exit-code",
    "check:generated": "node scripts/generate.mjs --check",
    "check:lint": "eslint . && buf lint packages/protocol",
    "dev:mcp-server": "pnpm --filter @seeker-vault/mcp-server run dev",
    "dev:mcp-skr-staking": "pnpm --filter @seeker-vault/skr-staking-server run dev",
    "dev:sidecar": "pnpm run dev:mcp-server",
    "format": "prettier --write . && buf format packages/protocol --write",
    "format:android": "apps/android/gradlew -p apps/android spotlessApply",
    "generate": "node scripts/generate.mjs",
    "pair": "node --env-file-if-exists=.env servers/mcp-server/src/cli.ts pair",
    "agent": "node --env-file-if-exists=.env tools/test-agent/src/main.ts",
    "test:hello": "node scripts/test-hello.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:load": "node scripts/test-load.mjs",
    "test:queue": "node --test --test-reporter=spec tools/test-agent/src/stage2.acceptance.ts",
    "test:transfer": "node --test --test-reporter=spec tools/test-agent/src/stage4.acceptance.ts",
    "test:push": "node --test --test-reporter=spec servers/mcp-server/src/push/*.test.ts servers/mcp-server/src/pairing/roles.test.ts && apps/android/gradlew -p apps/android :app:testDebugUnitTest --tests 'io.github.brrenat.seekervault.sync.Stage53AcceptanceTest' --tests 'io.github.brrenat.seekervault.push.*Test' --tests 'io.github.brrenat.seekervault.sync.PushSynchronizationTest' --tests 'io.github.brrenat.seekervault.sync.FeedSynchronizationTest' --tests 'io.github.brrenat.seekervault.sync.BackgroundSynchronizationTest' --tests 'io.github.brrenat.seekervault.notifications.*Test' --tests 'io.github.brrenat.seekervault.connections.ConnectionRepositoryTest.removingOrRevokingAConnectionRequestsNotificationCleanup' --tests 'io.github.brrenat.seekervault.InboxActivityTest.notificationTap*' --tests 'io.github.brrenat.seekervault.InboxActivityTest.staleNotificationTap*' --tests 'io.github.brrenat.seekervault.StageBoundaryTest'",
    "test:mcp-server-package": "node scripts/test-mcp-server-package.mjs",
    "test:server-sdk-package": "node scripts/test-server-sdk-package.mjs",
    "test:swap": "apps/android/gradlew -p apps/android :app:testDebugUnitTest --tests 'io.github.brrenat.seekervault.jupiter.*' --tests 'io.github.brrenat.seekervault.solana.*' --tests 'io.github.brrenat.seekervault.operations.*' --tests 'io.github.brrenat.seekervault.plugins.*' --tests 'io.github.brrenat.seekervault.transactions.*' --tests 'io.github.brrenat.seekervault.StageBoundaryTest'",
    "test:updates": "node --test --test-reporter=spec servers/mcp-server/src/updates/*.test.ts && apps/android/gradlew -p apps/android :app:testDebugUnitTest --tests 'io.github.brrenat.seekervault.sync.*Test' --tests io.github.brrenat.seekervault.updates.GrpcBidiInteropTest"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0"
  }
}
