# A publisher template's front door — internet-facing.
#
# Used by the `compose.public.yaml` overlay, which mounts this file instead of
# `Caddyfile` and publishes ports 80 and 443:
#
#   docker compose -f compose.yaml -f compose.public.yaml up -d --build
#
# Caddy obtains and renews a publicly trusted certificate for $PUBLISHER_DOMAIN
# by itself (https://caddyserver.com/docs/automatic-https). That needs the
# domain's A/AAAA record pointing at this host, ports 80 and 443 reachable from
# the internet, and the `proxy-data` volume kept: it holds the account key and
# the certificates.
#
# **What is on the internet here is a write API.** Unlike the shared gateway's
# read port, nothing this serves is public information: the token on it is the
# whole grant to publish as this server, so a deployment that does not need a
# remote strategy engine should not run this overlay at all. What TLS adds is
# that the token cannot be read off the wire — it does not make holding one
# safer (publisher/README.md).
{
	admin off
	# Where the certificate authority sends expiry and problem notices.
	email {$ACME_EMAIL}
	log {
		output stderr
		format console
	}
	# `log_credentials` is deliberately absent, so Caddy redacts the Authorization
	# header from every request log.
}

{$PUBLISHER_DOMAIN} {
	log {
		output stderr
		format console
	}

	header {
		# This host is HTTPS-only from now on; a downgrade is not an option.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@api path /v1/*
	handle @api {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8092
	}

	# /healthz is not published: it belongs to the operator, not to the internet.
	handle {
		abort
	}
}

# A request that arrives over TLS for some other host is not this deployment's.
# Caddy's own default for an unserved host is an empty 200; close the connection
# instead, so nothing here answers for a name it does not hold.
:443 {
	abort
}

# The operator's private endpoint. It binds the namespace's loopback address, so
# it cannot be published to the host at all: only the containers in this stack can
# reach it — the compose healthcheck, and `ctl`.
http://127.0.0.1:8093 {
	# A site address restricts the Host header, not the interface: without this the
	# socket would be open on every interface in the namespace, and compose could
	# publish it to the host.
	bind 127.0.0.1

	log {
		output stderr
		format console
	}
	log_skip /healthz

	@api path /v1/*
	handle @api {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8092
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8092
	}

	handle {
		abort
	}
}
