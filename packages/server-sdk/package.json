{
  "name": "@seeker_agent_connect/server-sdk",
  "version": "0.2.0-rc.1",
  "description": "Embeddable TypeScript SDK for Seeker Agent Connect direct servers",
  "keywords": [
    "seeker",
    "solana",
    "mobile-wallet-adapter",
    "sdk",
    "connectrpc",
    "agent"
  ],
  "homepage": "https://github.com/BrRenat/SeekerAgentConnect/tree/master/packages/server-sdk#readme",
  "bugs": {
    "url": "https://github.com/BrRenat/SeekerAgentConnect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrRenat/SeekerAgentConnect.git",
    "directory": "packages/server-sdk"
  },
  "license": "MIT",
  "author": "Renat Berezovsky",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "prepack": "pnpm run build",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "uqr": "0.1.3"
  }
}
