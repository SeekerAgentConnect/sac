{
  "name": "@seekeragentconnect/mcp-skr-staking",
  "version": "0.0.1",
  "description": "Standalone SKR staking MCP server for Seeker Agent Connect",
  "keywords": [
    "seeker",
    "solana",
    "skr",
    "staking",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/SeekerAgentConnect/sac/tree/master/servers/mcp-skr-staking#readme",
  "bugs": {
    "url": "https://github.com/SeekerAgentConnect/sac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeekerAgentConnect/sac.git",
    "directory": "servers/mcp-skr-staking"
  },
  "license": "MIT",
  "author": "Renat Berezovsky",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "seeker-skr-staking-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('package',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm --filter @seekeragentconnect/server-sdk run build && tsc -p tsconfig.build.json && node scripts/package.mjs",
    "dev": "node --env-file-if-exists=../../.env src/cli.ts start",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@modelcontextprotocol/sdk": "catalog:",
    "@seekeragentconnect/server-sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
