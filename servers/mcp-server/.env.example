# Application configuration reference. For Docker, copy compose/mcp/.env.example in
# the do-deploy repository;
# for source/npm, use the stable config.env described in README.md.
# Generate two different values with: openssl rand -hex 32
MCP_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
PHONE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080

MCP_ENABLED=true
MCP_DEMO_TOOLS=false
MCP_ALLOWED_HOSTS=
LIVE_COMMAND_TIMEOUT_SECONDS=60

# Required by the standalone container because 0.0.0.0 is a bind address, not an address a phone
# can call. For host-loopback development keep this value; a physical phone needs trusted HTTPS.
SIDECAR_PUBLIC_URL=http://127.0.0.1:8080

REQUEST_TTL_SECONDS=86400
REQUEST_PENDING_LIMIT=100
PAIRING_TOKEN_TTL_SECONDS=600

# Optional transfer/confirmation provider. Empty means the related operation is not served.
SOLANA_RPC_URL=
SOLANA_RPC_TIMEOUT_MS=10000

# The Solana networks this server's manifest declares: comma-separated mainnet, devnet, testnet.
# Empty or none declares none, and an up-to-date phone then signs nothing for this server. There
# is no default and SOLANA_RPC_URL is not read to guess one; changing it moves the revision.
SAC_SUPPORTED_NETWORKS=

# Optional FCM sender. Credentials use Application Default Credentials and must be mounted outside
# the image; no credential belongs in this file or in the package.
FCM_PROJECT_ID=

# Optional OAuth resource-server profile for /mcp. Static MCP_TOKEN and OAuth are alternative agent
# access paths; this server issues no OAuth tokens and holds no OAuth client secret.
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_SCOPE=

# Optional production HTTP/2 TLS listener. Mount the two files read-only when these are set.
SIDECAR_TLS_CERT_PATH=
SIDECAR_TLS_KEY_PATH=
SIDECAR_UPDATE_PORT=
# Optional: main listener is h2c and advertises SIDECAR_PUBLIC_URL as the update origin.
# Use behind a TLS-terminating HTTP/2 proxy (App Platform protocol: HTTP2). Requires https://
# SIDECAR_PUBLIC_URL. Cannot be combined with TLS paths or SIDECAR_UPDATE_PORT.
SIDECAR_H2C=false
