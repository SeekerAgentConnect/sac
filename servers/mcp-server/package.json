{
  "name": "@seeker-vault/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Seeker Agent Connect MCP server",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrRenat/SeekerAgentWallet.git",
    "directory": "mcp-server"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "bin": {
    "seeker-agent-connect-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('package',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm --filter @seeker-vault/server-sdk run build && tsc -p tsconfig.build.json && node scripts/package.mjs",
    "dev": "node --env-file-if-exists=../.env src/cli.ts start",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@seeker-vault/server-sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "firebase-admin": "14.4.0",
    "jose": "6.2.12",
    "uqr": "0.1.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "6.0.3"
  }
}
