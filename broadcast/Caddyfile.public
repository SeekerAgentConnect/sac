# The broadcast gateway's front door — internet-facing.
#
# Used by the `compose.public.yaml` overlay, which mounts this file instead of
# `Caddyfile` and publishes ports 80 and 443:
#
#   docker compose -f compose.yaml -f compose.public.yaml up -d --build
#
# Caddy obtains and renews a publicly trusted certificate for $BROADCAST_DOMAIN
# by itself (https://caddyserver.com/docs/automatic-https). That needs the
# domain's A/AAAA record pointing at this host, ports 80 and 443 reachable from
# the internet, and the `proxy-data` volume kept: it holds the account key and the
# certificates.
#
# Plain HTTP exists here only as the redirect to HTTPS that Caddy adds itself. A
# phone refuses an untrusted certificate, and that refusal is correct: a feed read
# over a connection someone else can rewrite is a feed someone else is
# publishing.
{
	admin off
	# Where the certificate authority sends expiry and problem notices.
	email {$ACME_EMAIL}
	log {
		output stderr
		format console
	}
	# `log_credentials` is deliberately absent, so Caddy redacts the Authorization
	# header from every request log: a publisher's credential is never written
	# down, here or in the gateway (broadcast/internal/gateway/auth.go).
}

{$BROADCAST_DOMAIN} {
	log {
		output stderr
		format console
	}
	log_skip /healthz
	# Invitation paths contain temporary capabilities and never enter access logs.
	log_skip /invite/*

	header {
		# This host is HTTPS-only from now on; a downgrade is not an option.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# --- The client API: what phones read ------------------------------------
	# Public and unauthenticated on purpose. Everything it serves is a document a
	# publisher published for everyone subscribed, and a read tells the gateway
	# nothing but which channel it is about.
	@feed path /seekervault.gateway.v1.FeedService/*
	handle @feed {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8090
	}

	# --- The publisher API: what developers' servers call --------------------
	# On the same name as the read API, and on a different socket behind it. The
	# separation that matters is not this routing rule: 8090 serves no handler
	# that could change anything, so a mistake here refuses a write rather than
	# accepting one (broadcast/internal/gateway/boundary_test.go).
	#
	# Two ways to narrow it further, both one edit in this file:
	#
	#   - delete this block, and publishers reach 127.0.0.1:8091 over a tunnel or
	#     a private interface instead. Phones are unaffected.
	#   - put it on its own name — a second site block for
	#     publish.example.com — if the operator would rather the two surfaces had
	#     separate certificates and separate logs.
	@publish path /seekervault.gateway.v1.PublisherService/*
	handle @publish {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8091
	}

	# --- Gateway-private onboarding and paired devices (SEE-109) -------------
	@onboarding path /invite/* /seekervault.gateway.v1.InvitationService/* /seekervault.gateway.v1.DeviceService/*
	handle @onboarding {
		request_body {
			max_size 64KiB
		}
		reverse_proxy 127.0.0.1:8092
	}

	# --- The stream: one gRPC procedure, and only that one (SEE-91) ----------
	# The path is fixed by the protocol, so this is an allow-list of exactly one
	# procedure: a listener consumes a stream of publications and can send
	# nothing on it. The broker's API, its admin surface and Redis are on the
	# internal network and have no route through here at all.
	#
	# h2c because gRPC is an HTTP/2 protocol and the hop behind this proxy is on a
	# private network: TLS is terminated here, at the one address a phone ever
	# learns — the gateway's own origin, which is also what a published manifest
	# has to name (SEE-88). A ticket names no host for exactly that reason.
	@stream path /centrifugal.centrifugo.unistream.CentrifugoUniStream/Consume
	handle @stream {
		reverse_proxy h2c://centrifugo:11000 {
			# A listener stays open for as long as the screen is on. Nothing here
			# may cut an idle stream: the transport sends no keep-alive of its
			# own, and HTTP/2's pings are the phone's (feeds/CentrifugoFeedStream).
			flush_interval -1
			transport http {
				versions h2c
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# /healthz is not published: it belongs to the operator, not to the internet.
	handle {
		abort
	}
}

# A request that arrives over TLS for some other host is not this deployment's.
# Caddy's own default for an unserved host is an empty 200; close the connection
# instead, so nothing here answers for a name it does not hold.
:443 {
	abort
}

# The operator's private endpoint. It binds the namespace's loopback address, so
# it cannot be published to the host at all: only the containers in this stack can
# reach it — the compose healthcheck, and `ctl`, which does not use the network.
http://127.0.0.1:8081 {
	# A site address restricts the Host header, not the interface: without this
	# the socket would be open on every interface in the namespace, and compose
	# could publish it to the host.
	bind 127.0.0.1

	log {
		output stderr
		format console
	}
	log_skip /healthz

	handle /healthz {
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		abort
	}
}
