{
  "$comment": [
    "The release manifest (SEE-168, SEE-182): every independently released component, its one",
    "version, and the artifacts that version names. A component's npm package, its GHCR image and",
    "its GitHub Release share this version and the commit its <component>-v<version> tag points at.",
    "Versions are changed with `pnpm release:bump <component> <version>`, never by hand in one",
    "place only: scripts/check-release.mjs proves the npm manifests, the in-source version",
    "constants and the Android build agree with this file, and .github/workflows/release.yml is",
    "driven by it. `checks` are the commands that must pass on the released commit before that",
    "component publishes anything. `previousVersions` and `previousArtifacts` are history: the",
    "pre-public 0.2.0 candidates and the Docker Hub images the unchanged do-deploy repository still",
    "pulls. They are never rewritten or republished."
  ],
  "repository": "SeekerAgentConnect/sac",
  "registries": {
    "npm": "https://registry.npmjs.org",
    "npmScope": "@seekeragentconnect",
    "images": "ghcr.io/seekeragentconnect"
  },
  "toolchain": {
    "npm": "11.19.0"
  },
  "tagPattern": "<component>-v<version>",
  "components": [
    {
      "id": "server-sdk",
      "directory": "packages/server-sdk",
      "version": "0.0.1",
      "description": "Embeddable TypeScript SDK for Seeker Agent Connect direct servers",
      "npm": {
        "name": "@seekeragentconnect/server-sdk",
        "packDirectory": "packages/server-sdk"
      },
      "image": null,
      "android": null,
      "vendors": [],
      "versionConstants": [],
      "toolchains": {},
      "checks": [
        "pnpm check",
        "pnpm check:generated",
        "pnpm test:server-sdk-package"
      ],
      "previousVersions": ["0.2.0-rc.1"],
      "previousArtifacts": []
    },
    {
      "id": "mcp-server",
      "directory": "servers/mcp-server",
      "version": "0.0.1",
      "description": "Self-hosted Seeker Agent Connect MCP server",
      "npm": {
        "name": "@seekeragentconnect/mcp-server",
        "packDirectory": "servers/mcp-server/package"
      },
      "image": {
        "repository": "ghcr.io/seekeragentconnect/mcp-server",
        "dockerfile": "servers/mcp-server/Dockerfile",
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      "android": null,
      "vendors": ["server-sdk"],
      "versionConstants": ["servers/mcp-server/src/version.ts"],
      "toolchains": {},
      "checks": [
        "pnpm check",
        "pnpm check:generated",
        "pnpm test:mcp-server-package"
      ],
      "previousVersions": ["0.2.0-rc.2"],
      "previousArtifacts": ["docker.io/brenat/seeker-agent-connect:mcp-0.1.8"]
    },
    {
      "id": "mcp-skr-staking",
      "directory": "servers/mcp-skr-staking",
      "version": "0.0.1",
      "description": "Standalone SKR staking MCP server for Seeker Agent Connect",
      "npm": {
        "name": "@seekeragentconnect/mcp-skr-staking",
        "packDirectory": "servers/mcp-skr-staking/package"
      },
      "image": {
        "repository": "ghcr.io/seekeragentconnect/mcp-skr-staking",
        "dockerfile": "servers/mcp-skr-staking/Dockerfile",
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      "android": null,
      "vendors": ["server-sdk"],
      "versionConstants": ["servers/mcp-skr-staking/src/server.ts"],
      "toolchains": {},
      "checks": [
        "pnpm check",
        "pnpm check:generated",
        "pnpm test:skr-staking-package"
      ],
      "previousVersions": ["0.2.0-rc.1"],
      "previousArtifacts": [
        "docker.io/brenat/seeker-agent-connect:skr-staking-mcp-0.1.3"
      ]
    },
    {
      "id": "gateway",
      "directory": "services/gateway",
      "version": "0.0.1",
      "description": "Seeker Agent Connect public feed gateway",
      "npm": null,
      "image": {
        "repository": "ghcr.io/seekeragentconnect/gateway",
        "dockerfile": "services/gateway/Dockerfile",
        "target": "console",
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      "android": null,
      "vendors": [],
      "versionConstants": [],
      "toolchains": {
        "go": "services/gateway/go.mod"
      },
      "checks": ["pnpm check:gateway"],
      "previousVersions": ["0.2.0-rc.1"],
      "previousArtifacts": [
        "docker.io/brenat/seeker-agent-connect:gateway-0.1.10"
      ]
    },
    {
      "id": "gateway-centrifugo",
      "directory": "services/gateway",
      "version": "0.0.1",
      "description": "Centrifugo broker with the feed gateway's pinned configuration",
      "npm": null,
      "image": {
        "repository": "ghcr.io/seekeragentconnect/gateway-centrifugo",
        "dockerfile": "services/gateway/Dockerfile.centrifugo",
        "context": "services/gateway",
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      "android": null,
      "vendors": [],
      "versionConstants": [],
      "toolchains": {
        "go": "services/gateway/go.mod"
      },
      "checks": ["pnpm check:gateway"],
      "previousVersions": ["0.2.0-rc.1"],
      "previousArtifacts": [
        "docker.io/brenat/seeker-agent-connect:centrifugo-0.1.2"
      ]
    },
    {
      "id": "demo-signals",
      "directory": "examples/demo-signals",
      "version": "0.0.1",
      "description": "CopyTrading signals publisher demo",
      "npm": null,
      "image": {
        "repository": "ghcr.io/seekeragentconnect/demo-signals",
        "dockerfile": "examples/demo-signals/Dockerfile",
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      "android": null,
      "vendors": [],
      "versionConstants": [],
      "toolchains": {
        "go": "examples/demo-signals/go.mod"
      },
      "checks": ["pnpm check:demo-signals"],
      "previousVersions": ["0.2.0-rc.1"],
      "previousArtifacts": [
        "docker.io/brenat/seeker-agent-connect:copytrading-0.1.7"
      ]
    },
    {
      "id": "demo-prediction",
      "directory": "examples/demo-prediction",
      "version": "0.0.1",
      "description": "Jupiter Prediction markets publisher demo",
      "npm": null,
      "image": {
        "repository": "ghcr.io/seekeragentconnect/demo-prediction",
        "dockerfile": "examples/demo-prediction/Dockerfile",
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      "android": null,
      "vendors": [],
      "versionConstants": [],
      "toolchains": {
        "go": "examples/demo-prediction/go.mod"
      },
      "checks": ["pnpm check:demo-prediction"],
      "previousVersions": ["0.2.0-rc.1"],
      "previousArtifacts": [
        "docker.io/brenat/seeker-agent-connect:prediction-0.1.9"
      ]
    },
    {
      "id": "android",
      "directory": "apps/android",
      "version": "0.0.1",
      "description": "Seeker Agent Connect Android app",
      "npm": null,
      "image": null,
      "android": {
        "applicationId": "io.github.brrenat.seekervault",
        "versionCode": 2,
        "previousVersionCode": 1,
        "apk": "sac-<version>.apk",
        "releaseRequires": ["firebase", "solanaRpc", "relayUrl"]
      },
      "vendors": [],
      "versionConstants": [],
      "toolchains": {
        "java": "21"
      },
      "checks": ["pnpm check:android", "pnpm check:swap-fee-build"],
      "previousVersions": ["0.1.0"],
      "previousArtifacts": []
    }
  ]
}
